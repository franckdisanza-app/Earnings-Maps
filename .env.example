# Copy to .env (gitignored) and fill in. Never commit .env.
# SEC EDGAR fair-access policy requires a real name and email in the User-Agent of every request.
SEC_USER_AGENT="Firstname Lastname you@example.com"

# HyperFrames CLI opt-outs (it loads .env from the current folder). See SKILLS.md.
HYPERFRAMES_NO_TELEMETRY=1
DO_NOT_TRACK=1
HYPERFRAMES_NO_UPDATE_CHECK=1
HYPERFRAMES_NO_AUTO_INSTALL=1
HYPERFRAMES_SKIP_SKILLS=1

# Kokoro runs in its own venv (Python 3.10–3.13). Absolute path to .venv-tts/Scripts/python.exe on this machine.
HYPERFRAMES_PYTHON=C:\path\to\repo\.venv-tts\Scripts\python.exe
