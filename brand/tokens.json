{
  "$comment": "Earnings Maps design tokens. DRAFT: the owner picks one theme and one voice at Gate 2 (Phase 4); the other themes are then deleted. References: FT and The Economist for restraint, without their signatures (no salmon background, no red box).",
  "status": "draft",
  "brand": {
    "name": "Earnings Maps",
    "handle": "@earningsmaps",
    "domain": "earningsmaps.com"
  },
  "canvas": {
    "video": { "width": 1080, "height": 1920, "fps": 30, "codec": "h264", "audio": "aac", "duration_s": [25, 35] },
    "cover_9x16": { "width": 1080, "height": 1920 },
    "cover_4x5": { "width": 1080, "height": 1350 },
    "carousel": { "width": 1080, "height": 1350, "slides": [6, 8] }
  },
  "safe_zone_9x16": {
    "$comment": "Rule of thumb from the brief; confirm with a private test upload. Critical text stays inside.",
    "top_px": 154,
    "bottom_px": 384,
    "right_px": 130,
    "left_px": 64
  },
  "font": {
    "family": "Inter",
    "files": {
      "variable": "brand/fonts/InterVariable.woff2",
      "variable_italic": "brand/fonts/InterVariable-Italic.woff2"
    },
    "license": "SIL OFL 1.1 (brand/fonts/OFL.txt)",
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "black": 800 },
    "numerals": "tabular-nums",
    "letter_spacing_numbers_em": -0.02
  },
  "type_scale_px": {
    "$comment": "Minimums from the brief: labels >= 44 px, key numbers >= 72 px at 1080 wide.",
    "label_min": 44,
    "label": 48,
    "body": 52,
    "number_min": 72,
    "number": 96,
    "hero_number": 160,
    "hook": 88,
    "footer": 32,
    "footer_note": "Footer lines (source, period, disclaimer) sit at 32 px. They're legally required, not a key number or label; checked for legibility at Gate 2."
  },
  "readability": {
    "max_words_on_screen": 7,
    "min_number_hold_s": 1.5,
    "min_contrast_ratio_text": 4.5,
    "min_contrast_ratio_large": 3.0
  },
  "themes": {
    "dark-editorial": {
      "background": "#0F1216",
      "surface": "#171B21",
      "ink": "#ECEAE4",
      "ink_muted": "#9AA0A6",
      "rule": "#2A3038",
      "revenue": "#5B8DD6",
      "cost": "#8C7B7A",
      "profit": "#4FA97F",
      "loss": "#E0574A",
      "accent": "#E8B04B"
    },
    "light-editorial": {
      "background": "#F6F4EF",
      "surface": "#FFFFFF",
      "ink": "#1A1A1A",
      "ink_muted": "#5F5A54",
      "rule": "#D8D3CA",
      "revenue": "#2E5E9E",
      "cost": "#9C8784",
      "profit": "#2F7D5B",
      "loss": "#B83227",
      "accent": "#C77C02"
    },
    "bold": {
      "background": "#0B0B0F",
      "surface": "#16161D",
      "ink": "#FFFFFF",
      "ink_muted": "#B4B4C0",
      "rule": "#2B2B36",
      "revenue": "#2F6BFF",
      "cost": "#A8908D",
      "profit": "#1FD18B",
      "loss": "#FF4B3E",
      "accent": "#FFD23F"
    }
  },
  "format": {
    "money": {
      "rule": "Billions with one decimal ($94.9B); below $1B use millions with no decimal ($812M). Negative values use U+2212 and parentheses only where the release does.",
      "examples": ["$94.9B", "$1.0B", "$812M", "−$1.2B"]
    },
    "change": {
      "rule": "Whole percent with sign; U+2212 minus for declines; one decimal only when |change| < 1%.",
      "examples": ["+6%", "−3%", "+0.4%"]
    },
    "margin": { "rule": "Whole percent, one decimal when the change vs last year is under one point.", "examples": ["46%", "31.4%"] },
    "period": { "rule": "Fiscal label plus calendar months.", "examples": ["Fiscal Q4 2026 (Jul–Sep 2026)"] },
    "our_calculation_label": "our calculation"
  },
  "motion": {
    "engine": "GSAP 3.14.2 (local file), one paused seekable timeline per composition",
    "ease_default": "power2.out",
    "flow_build_s": [2, 18],
    "insight_s": [18, 26],
    "end_card_s": [26, 30],
    "final_hold_s": 2
  },
  "voice": {
    "engine": "kokoro (npx hyperframes tts, local)",
    "voice": null,
    "candidates": ["af_heart", "am_michael", "bm_george"],
    "samples": "brand/voice-samples/",
    "speed": 1.0,
    "ai_label_required": true
  }
}
